# CUDA 版 ONNX Runtime 构建(libstdc++ ABI —— CUDA 的 host_defines.h 在 x86 拒 libc++)。
#
# 工具链照搬 pykeio/ort-artifacts:clang-21 + CUDA 13。
# CUDA 版与 CPU 版的 libc++/clang-16 约束无关 —— CUDA 走 libstdc++(clang 默认 stdlib),
# 且消费端走 ort load-dynamic(运行时 dlopen,不经 zig 链接 C++),故用哪个 clang 不受 ABI 契约约束。
# 此前 clang-16/g++-12 wrapper/nvcc 诊断探测 那套是为 CPU 的 libc++ 路线,不适用于 CUDA。
#
# 基础镜像 nvidia/cuda 的 cudnn-devel 变体 —— 自带 nvcc + CUDA runtime(cudart/cublas/...)+ cuDNN devel 头,
# 免在容器里手装 CUDA。CUDA 编译不需 GPU(仅运行期需要),故普通 CPU runner 即可构建。
ARG CUDA_BASE=nvidia/cuda:13.2.1-cudnn-devel-ubuntu22.04
FROM ${CUDA_BASE}

ENV DEBIAN_FRONTEND=noninteractive
ENV CC=clang-21
ENV CXX=clang++-21
ENV CUDA_HOME=/usr/local/cuda

# 1) clang-21 + llvm-21 —— CUDA host 编译器(照搬 pyke 的 clang-21)。
#    CUDA 走 libstdc++(clang 默认 stdlib):host_defines.h 在 x86 对 libc++ #error,故不装 libc++-dev。
#    jammy 自带 gcc-11 的 libstdc++ 够现代(<span> 等 C++20 头齐全),无需 PPA g++-12/clang-16 那套。
#    llvm-21 提供 llvm-nm(verify_abi.sh 用)。UBUNTU_CODENAME 来自基础镜像 /etc/os-release(jammy)。
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg wget git build-essential; \
    . /etc/os-release; \
    wget -qO - https://apt.llvm.org/llvm-snapshot.gpg.key | gpg --dearmor -o /usr/share/keyrings/llvm.gpg; \
    echo "deb [signed-by=/usr/share/keyrings/llvm.gpg] http://apt.llvm.org/${UBUNTU_CODENAME} llvm-toolchain-${UBUNTU_CODENAME}-21 main" \
        > /etc/apt/sources.list.d/llvm.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends clang-21 llvm-21; \
    rm -rf /var/lib/apt/lists/*

# 2) Python 3.11 + cmake/ninja via Miniforge3 —— 与 CPU Dockerfile 一致(ORT build 刚需
#    flatbuffers 等,且要求 cmake≥3.26)。uname -m 自适应 amd64(CUDA 只做 x86_64)。
RUN set -eux; \
    ARCH="$(uname -m)"; \
    case "$ARCH" in \
         x86_64)  M=x86_64 ;; \
         aarch64) M=aarch64 ;; \
         *) echo "unsupported architecture: $ARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/miniforge.sh \
         "https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-${M}.sh"; \
    bash /tmp/miniforge.sh -b -p /opt/miniforge3; \
    rm /tmp/miniforge.sh; \
    /opt/miniforge3/bin/conda create -y -n ortbuild python=3.11; \
    /opt/miniforge3/envs/ortbuild/bin/pip install --no-cache-dir flatbuffers numpy packaging protobuf; \
    /opt/miniforge3/bin/conda install -n ortbuild -y -c conda-forge cmake ninja; \
    ln -sf /opt/miniforge3/envs/ortbuild/bin/python3 /usr/local/bin/python3; \
    ln -sf /opt/miniforge3/envs/ortbuild/bin/python3 /usr/local/bin/python

ENV PATH=/opt/miniforge3/envs/ortbuild/bin:${PATH}

WORKDIR /work

COPY scripts/ /work/scripts/
COPY src/ /work/src/
RUN chmod +x /work/scripts/*.sh
